# Каталоги runtime. В compose их перекрывают volume-пути.
DOCLOOM_DATA=./data
DOCLOOM_PUBLISH=./publish
DOCLOOM_SOURCES=./data/sources
# Корни, внутри которых разрешён local_path. Через двоеточие.
DOCLOOM_SOURCE_ROOTS=
# 1 — билд внутри запроса API (удобно для отладки). В compose оставить 0: билдит worker.
DOCLOOM_SYNC_BUILDS=0
DOCLOOM_HOST=0.0.0.0
DOCLOOM_PORT=8000
# Если задан, POST /hooks/git требует X-Hub-Signature-256.
DOCLOOM_WEBHOOK_SECRET=
