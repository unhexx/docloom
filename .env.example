# Каталоги runtime. В compose их перекрывают volume-пути.
DOCLOOM_DATA=./data
DOCLOOM_PUBLISH=./publish
DOCLOOM_SOURCES=./data/sources
# Корни, внутри которых разрешён local_path. Через двоеточие.
DOCLOOM_SOURCE_ROOTS=
# 1 — билд внутри запроса API (удобно для отладки). В compose оставить 0: билдит worker.
DOCLOOM_SYNC_BUILDS=0
DOCLOOM_HOST=0.0.0.0
DOCLOOM_PORT=8000
# Если задан, POST /hooks/git требует X-Hub-Signature-256 или X-Hub-Signature.
DOCLOOM_WEBHOOK_SECRET=
# Один репозиторий, который watch опрашивает сам. Пусто — наблюдение спит.
DOCLOOM_WATCH_URL=
DOCLOOM_WATCH_REF=master
DOCLOOM_WATCH_INTERVAL=60
# HTTP-токен Bitbucket. Не коммитить: файл .env в gitignore.
DOCLOOM_GIT_TOKEN=
# 0 — не проверять сертификат, если у сервера имя не совпадает с сертификатом.
DOCLOOM_GIT_SSL_VERIFY=1
# Запись в /etc/hosts контейнера, если имя Bitbucket не резолвится из Docker.
# Пример: git.example.com:203.0.113.10
DOCLOOM_EXTRA_HOST=
